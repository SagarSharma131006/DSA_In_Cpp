// LeetCode #2215 - Find the Difference of Two Arrays
// Difficulty: Easy
// Topic: Time & Space Complexity
// Approach: Hash Set
class Solution {
public:
    vector<vector<int>> findDifference(vector<int>& nums1, vector<int>& nums2) {
        // nums1 ko unordered_set mein convert kiya — duplicates apne aap hat gaye
        unordered_set<int> set1(nums1.begin(), nums1.end());

        // nums2 ko bhi unordered_set mein convert kiya
        unordered_set<int> set2(nums2.begin(), nums2.end());

        vector<int> onlyInNums1;
        vector<int> onlyInNums2;

        // set1 ke har number ko check kiya — set2 mein nahi mila toh answer[0] mein daala
        for (int num : set1) {
            if (set2.find(num) == set2.end()) {
                onlyInNums1.push_back(num);
            }
        }

        // set2 ke har number ko check kiya — set1 mein nahi mila toh answer[1] mein daala
        for (int num : set2) {
            if (set1.find(num) == set1.end()) {
                onlyInNums2.push_back(num);
            }
        }

        // required format: dono vectors ko ek vector<vector<int>> mein wrap karke return kiya
        return {onlyInNums1, onlyInNums2};
    }
};
/*
Time Complexity: O(n + m) average
Space Complexity: O(n + m)
*/
